<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TextEditor"
             x:Class="TextEditor.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#512BD4</Color>
            <Color x:Key="SecondaryColor">#DFD8F7</Color>
            <Color x:Key="TertiaryColor">#2B0B98</Color>
            <Color x:Key="WhiteColor">White</Color>
            <Color x:Key="BlackColor">Black</Color>
            <Color x:Key="GrayColor">Gray</Color>
            <Color x:Key="LightGrayColor">#F0F0F0</Color>
            
            <Style TargetType="Button">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="10"/>
            </Style>
            
            <Style TargetType="Editor">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="PlaceholderColor" Value="Gray"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
